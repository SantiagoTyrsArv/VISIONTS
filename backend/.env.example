# Copia a .env para desarrollo local fuera de Docker.
DATABASE_URL=postgresql+psycopg://senavoz:senavoz@localhost:5432/senavoz
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Lista separada por comas
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_REFRESH=30/minute
